# Copy to .env and adjust. Never commit the real .env.
JWT_SECRET=replace-with-output-of__openssl_rand_-base64_48
ADMIN_EMAIL=admin@payflow.dev
ADMIN_PASSWORD=choose-a-strong-password-123
FRAUD_ENABLED=true
DEMO_MODE=false                 # true = demo accounts on the sign-in page
OTP_SANDBOX_SHOW_CODE=true      # show OTPs on screen (no email/SMS provider)
HOLD_RELEASE_MINUTES=60
ESCROW_REVIEW_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
